generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Skill {
  id             Int    @id @default(autoincrement())
  name           String
  normalizedName String @unique
  description    String
  category       String
  platform       String
  author         String
  favs           Int    @default(0)
}

model User {
  id           Int    @id @default(autoincrement())
  email        String @unique
  passwordHash String
}
